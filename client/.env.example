# ===================================================
# NextHire Frontend — Environment Variables Template
# Copy this to .env and fill in your real values
# ===================================================

# Backend API URL
# Development: http://localhost:8000
# Production:  https://nexthire-api.onrender.com  ← replace with your Render URL
REACT_APP_API_URL=http://localhost:8000

# Disable source maps in production (keeps bundle smaller)
GENERATE_SOURCEMAP=false
